# ── VisionSentinel — Variáveis de Ambiente ──────────────────────────────────
# Copie este arquivo para .env e ajuste os valores para o seu ambiente.
# NUNCA suba o arquivo .env para o GitHub!

# Caminho para o modelo YOLOv8 (baixado automaticamente se não existir)
MODEL_PATH=models/yolov8n.pt

# Confiança mínima para aceitar uma detecção (0.0 a 1.0)
CONFIDENCE_THRESHOLD=0.45

# Classes a monitorar (separe por vírgula, sem espaços)
TARGET_CLASSES=person,car,truck,bicycle

# Caminho para o banco de dados SQLite
DB_PATH=data/detections.db
